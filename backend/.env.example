# Copy to backend/.env for LOCAL development only. Never commit .env.
# Same variable names in every environment; staging/production values are set in Coolify
# (Technical Stack Charter v1.1, "Database rules"). Use your own local-only passwords (12+ chars).

APP_ENV=local

# --- Connection (the database name is `teamora` in every environment) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=teamora

# --- Database bootstrap (backend/db/bootstrap.ps1 / bootstrap.sh) ---
# Superuser used only to run the bootstrap. Leave PGPASSWORD unset to be prompted instead.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres

# Role passwords the bootstrap sets. Each service logs in with its own one
# (auth-service -> POSTGRES_SVC_AUTH_PASSWORD, requisition-service -> POSTGRES_SVC_REQUISITION_PASSWORD, ...).
# Don't set PORT here: every service reads this file and uses its own default port (3001, 3002, ...).
POSTGRES_MIGRATOR_PASSWORD=change-me-local-migrator
POSTGRES_SVC_AUTH_PASSWORD=change-me-local-auth
POSTGRES_SVC_REQUISITION_PASSWORD=change-me-local-requisition
POSTGRES_SVC_PUBLISH_PASSWORD=change-me-local-publish
POSTGRES_SVC_CANDIDATE_PASSWORD=change-me-local-candidate
POSTGRES_SVC_DEDUPE_PASSWORD=change-me-local-dedupe
POSTGRES_SVC_NOTIFICATION_PASSWORD=change-me-local-notification

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
